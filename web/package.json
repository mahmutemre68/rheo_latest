{
  "name": "rheo-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:daily": "node scripts/test-daily-reward-state.mjs && node scripts/test-daily-reward-mounted.cjs",
    "test:share": "node scripts/test-share-target.mjs",
    "test:mount": "esbuild scripts/schema-mount.jsx --bundle --format=iife --jsx=automatic --loader:.js=jsx --define:process.env.NODE_ENV='\"production\"' --define:import.meta.env.BASE_URL='\"./\"' --outfile=dist-test/schema-mount.js --log-level=error && node scripts/test-schema-mount.cjs dist-test/schema-mount.js",
    "test:schema": "node scripts/test-exercise-schema.mjs",
    "validate": "node scripts/validate-pool.mjs",
    "test": "npm run validate && npm run test:schema && npm run test:generated && npm run test:placement && npm run test:mount && npm run test:daily && npm run test:share",
    "test:generated": "node scripts/test-generated-merge.mjs",
    "test:placement": "node scripts/test-placement.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
