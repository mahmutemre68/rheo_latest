# Copy to web/.env.local and fill from Firebase console → Project settings → Your apps → Web app.
# Without these, Find Match falls back to labelled practice bots.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
