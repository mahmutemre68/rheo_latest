{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "queue": { ".read": false, ".write": false },
    "matchesPrivate": { ".read": false, ".write": false },

    "matches": {
      "$matchId": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        "presence": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('matches').child($matchId).child('players').child(auth.uid).exists() && root.child('matches').child($matchId).child('state').val() !== 'done'",
            ".validate": "newData.hasChildren(['online', 'at']) && newData.child('online').isBoolean() && newData.child('at').val() === now",
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
